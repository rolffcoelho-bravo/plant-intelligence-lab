# Biological data policy
# Raw, interim and processed datasets are materialized reproducibly by the notebooks
# and remain outside Git. Public result summaries and figures belong under reports/.
data/raw/**
data/interim/**
data/processed/**

# Preserve directory placeholders if later added
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Large genomic archives / matrices
*.h5
*.hdf5
*.vcf
*.vcf.gz
*.bcf
*.tar.gz

# OS files
.DS_Store
Thumbs.db
